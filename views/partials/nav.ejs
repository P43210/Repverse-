<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand fade-in-logo" aria-label="Repverse home">
      <img src="/img/logo-lockup.svg" alt="Repverse" height="22" />
    </a>

    <nav class="nav-links">
      <a href="/compare" class="<%= path === '/compare' ? 'active' : '' %>">Compare</a>
      <a href="/stake-calculator" class="<%= path === '/stake-calculator' ? 'active' : '' %>">Stake calculator</a>
      <a href="/converter" class="<%= path === '/converter' ? 'active' : '' %>">Converter</a>
      <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
    </nav>

    <div class="nav-actions">
      <% if (currentUser) { %>
        <a href="/dashboard" class="btn btn-ghost">
          <% if (currentUser.authType === 'wallet') { %>
            <span class="dot dot-online"></span> <%= currentUser.name %>
          <% } else { %>
            <%= currentUser.name || currentUser.email %>
          <% } %>
        </a>
        <a href="/logout" class="btn btn-outline">Log out</a>
      <% } else { %>
        <a href="/login" class="btn btn-outline">Sign in</a>
        <a href="/wallet/leather.btc" class="btn btn-primary">Explore now</a>
      <% } %>
    </div>

    <button class="nav-burger" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
